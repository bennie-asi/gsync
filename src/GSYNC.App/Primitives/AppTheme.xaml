<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="AppPagePadding">22</Thickness>
    <Thickness x:Key="AppInlinePadding">10,8</Thickness>
    <Thickness x:Key="AppPanelPadding">14</Thickness>
    <CornerRadius x:Key="AppCornerRadius">8</CornerRadius>
    <x:Double x:Key="AppCompactPaneLength">54</x:Double>
    <x:Double x:Key="AppOpenPaneLength">208</x:Double>
    <x:Double x:Key="AppNavRailWidth">220</x:Double>
    <GridLength x:Key="AppNavRailColumnWidth">220</GridLength>
    <x:Double x:Key="AppNavRailButtonWidth">200</x:Double>
    <x:Double x:Key="AppNavRailIconSlotSize">20</x:Double>
    <x:Double x:Key="AppTitleBarHeight">38</x:Double>
    <x:Double x:Key="AppDenseRowHeight">40</x:Double>
    <x:Double x:Key="AppSectionSpacing">14</x:Double>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF101419" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF1A2028" />
    <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#FF253039" />
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#FF151B21" />
    <SolidColorBrush x:Key="AppInputBrush" Color="#FF111820" />
    <SolidColorBrush x:Key="AppDividerBrush" Color="#FF34414B" />
    <SolidColorBrush x:Key="AppPrimaryBrush" Color="#FF00C9A7" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF6EDDB8" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="#FFFFBF58" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="#FFEE7D77" />
    <SolidColorBrush x:Key="AppMutedBrush" Color="#FF9BAAB8" />
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFE8EDF2" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FFB1BEC9" />
    <SolidColorBrush x:Key="AppTextDimBrush" Color="#FF9DAFBC" />

    <SolidColorBrush x:Key="BadgeSyncedBrush" Color="#FF6EDDB8" />
    <SolidColorBrush x:Key="BadgeLocalNewerBrush" Color="#FFFFBF58" />
    <SolidColorBrush x:Key="BadgeRemoteNewerBrush" Color="#FF8FB3FF" />
    <SolidColorBrush x:Key="BadgeConflictBrush" Color="#FFFFBF58" />
    <SolidColorBrush x:Key="BadgePendingBrush" Color="#FFFFBF58" />
    <SolidColorBrush x:Key="BadgeMissingBrush" Color="#FF8D97B3" />
    <SolidColorBrush x:Key="BadgeDisabledBrush" Color="#FF6B7592" />
    <SolidColorBrush x:Key="BadgeReadyBrush" Color="#FF00C9A7" />

    <Style TargetType="Page">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="RailNavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{StaticResource AppSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}" />
        <Setter Property="Foreground" Value="#FF0B0E17" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="SecondaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AppSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="DesiredCandidateWindowAlignment" Value="BottomEdge" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource AppSurfaceAltBrush}" />
    </Style>
</ResourceDictionary>
