<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GSYNC.App.Primitives.GameArtwork" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource AppSurfaceRaisedBrush}" CornerRadius="8">
        <Grid>
            <TextBlock Text="{Binding FallbackText, ElementName=Root}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
        </Grid>
    </Border>
</UserControl>
