<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GSYNC.App.Primitives.AppNavRail"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch">
    <Border Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,0,1,0">
        <Grid x:Name="RootGrid" Padding="10,18,10,12" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="BrandPanel" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="3,0,0,0">
                <Border Width="38" Height="38" Background="{StaticResource AppPrimaryBrush}" CornerRadius="9">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#FF0B1715" Text="G" />
                </Border>
                <StackPanel x:Name="BrandTextPanel" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="GSYNC" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="BrandSubtitleTextBlock" FontSize="11" Foreground="{StaticResource AppTextDimBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Top">
                <Button x:Name="LibraryButton" Tag="library" Click="NavButton_Click" Style="{StaticResource RailNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon x:Name="LibraryIcon" Style="{StaticResource AppIcon}" Glyph="{StaticResource IconLibrary}" /><TextBlock x:Name="LibraryTextBlock" Text="Library" FontSize="14" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="TargetsButton" Tag="targets" Click="NavButton_Click" Style="{StaticResource RailNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon x:Name="TargetsIcon" Style="{StaticResource AppIcon}" Glyph="{StaticResource IconTargets}" /><TextBlock x:Name="TargetsTextBlock" Text="Targets" FontSize="14" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="VariablesButton" Tag="variables" Click="NavButton_Click" Style="{StaticResource RailNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon x:Name="VariablesIcon" Style="{StaticResource AppIcon}" Glyph="{StaticResource IconVariables}" /><TextBlock x:Name="VariablesTextBlock" Text="Variables" FontSize="14" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="HistoryButton" Tag="history" Click="NavButton_Click" Style="{StaticResource RailNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon x:Name="HistoryIcon" Style="{StaticResource AppIcon}" Glyph="{StaticResource IconHistory}" /><TextBlock x:Name="HistoryTextBlock" Text="History" FontSize="14" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="QueueButton" Tag="queue" Click="NavButton_Click" Style="{StaticResource RailNavButtonStyle}">
                    <Grid x:Name="QueueIconGrid" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon x:Name="QueueIcon" Style="{StaticResource AppIcon}" Glyph="{StaticResource IconQueue}" />
                        <TextBlock x:Name="QueueTextBlock" Grid.Column="1" Text="Queue" FontSize="14" VerticalAlignment="Center" />
                        <Border x:Name="QueueBadgeBorder" Grid.Column="2" Padding="5,1" Background="{StaticResource AppPrimaryBrush}" CornerRadius="6" Visibility="Collapsed">
                            <TextBlock x:Name="QueueBadgeTextBlock" FontSize="10" FontWeight="SemiBold" Foreground="#FF0B1715" Text="0" />
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="6">
                <Border x:Name="TargetStatusCard" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                    <TextBlock Text="{Binding TargetStatusText, ElementName=Root}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                </Border>
                <Button x:Name="SettingsButton" Tag="settings" Click="NavButton_Click" Style="{StaticResource RailNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon x:Name="SettingsIcon" Style="{StaticResource AppIcon}" Glyph="{StaticResource IconSettings}" /><TextBlock x:Name="SettingsTextBlock" Text="Settings" FontSize="14" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="ToggleRailButton" Click="ToggleRail_Click" Style="{StaticResource RailNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon x:Name="ToggleRailIcon" Style="{StaticResource AppIcon}" Glyph="&#xE5CB;" /><TextBlock x:Name="ToggleRailTextBlock" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
