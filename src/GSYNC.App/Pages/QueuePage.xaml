<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GSYNC.App.Pages.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:GSYNC.App.Primitives"
    xmlns:vm="using:GSYNC.App.ViewModels">
    <Page.Resources>
        <DataTemplate x:Key="ActiveJobTemplate" x:DataType="vm:QueueRow">
            <Border Background="{StaticResource AppSurfaceRaisedBrush}" BorderBrush="{StaticResource AppPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <primitives:Badge Text="{Binding Direction}" Variant="ready" />
                            <primitives:Badge Text="{Binding Status}" Variant="{Binding StatusVariant}" />
                        </StackPanel>
                        <TextBlock Text="{Binding EnqueuedText}" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" IsIndeterminate="{Binding IsProgressIndeterminate}" Foreground="{StaticResource AppPrimaryBrush}" />
                    <TextBlock Text="{Binding CurrentFileText}" Foreground="{StaticResource AppTextDimBrush}" TextWrapping="WrapWholeWords" />
                    <Button Content="{Binding ActionText}" Click="CancelJob_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PendingJobTemplate" x:DataType="vm:QueueRow">
            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <primitives:Badge Text="{Binding Direction}" Variant="ready" />
                        <primitives:Badge Text="{Binding Status}" Variant="{Binding StatusVariant}" />
                    </StackPanel>
                    <TextBlock Text="{Binding EnqueuedText}" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    <Button Content="{Binding ActionText}" Click="RemoveJob_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid x:Name="MainContentRoot" Padding="{StaticResource AppPagePadding}" RowSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <primitives:SectionHeader Title="{Binding PageTitle}" Subtitle="{Binding PageSubtitle}" />
                <Button Grid.Column="1" Content="{Binding HistoryText}" Click="GoToHistoryButton_Click" VerticalAlignment="Top" Style="{StaticResource SecondaryToolbarButtonStyle}" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                <StackPanel Spacing="18">
                    <TextBlock Text="{Binding SystemStatus}" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <TextBlock Text="{Binding QueueNote}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                    </Border>
                    <StackPanel Spacing="10" Visibility="{Binding HasActiveJobs, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ActiveTitle}" FontSize="16" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding ActiveJobs}" ItemTemplate="{StaticResource ActiveJobTemplate}" />
                    </StackPanel>
                    <StackPanel Spacing="10" Visibility="{Binding HasPendingJobs, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding PendingTitle}" FontSize="16" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding PendingJobs}" ItemTemplate="{StaticResource PendingJobTemplate}" />
                    </StackPanel>
                    <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                            <Button Content="{Binding LibraryText}" Click="GoToLibraryButton_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryToolbarButtonStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding HistoryTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding HistoryNote}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                            <Button Content="{Binding HistoryText}" Click="GoToHistoryButton_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border x:Name="InitializationErrorPanel" MaxWidth="720" Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
            <StackPanel Spacing="16">
                <primitives:InfoCallout Title="队列页加载失败" Message="请重试加载，或前往其他页面。" Severity="Error" />
                <TextBlock x:Name="InitializationErrorMessage" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                <Button Click="RetryInitialization_Click" Content="重试加载" Style="{StaticResource PrimaryToolbarButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
