<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GSYNC.App.Pages.ConflictResolutionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:GSYNC.App.Primitives"
    xmlns:vm="using:GSYNC.App.ViewModels">
    <Page.Resources>
        <DataTemplate x:Key="ConflictFilenameTemplate" x:DataType="vm:ConflictFileRow">
            <TextBlock Text="{x:Bind DisplayFilename}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTipService.ToolTip="{x:Bind Filename}" AutomationProperties.Name="{x:Bind Filename}" />
        </DataTemplate>
        <DataTemplate x:Key="ConflictActionTemplate" x:DataType="vm:ConflictFileRow">
            <DropDownButton Content="{x:Bind ActionText}" AutomationProperties.Name="{x:Bind DecisionLabel}">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="{x:Bind KeepLocalText}" Tag="{x:Bind Filename}" IsEnabled="{x:Bind CanKeepLocal}" Click="KeepLocalDecision_Click" />
                        <MenuFlyoutItem Text="{x:Bind KeepRemoteText}" Tag="{x:Bind Filename}" IsEnabled="{x:Bind CanKeepRemote}" Click="KeepRemoteDecision_Click" />
                        <MenuFlyoutItem Text="{x:Bind RemoveRemoteText}" Tag="{x:Bind Filename}" IsEnabled="{x:Bind CanRemoveRemote}" Click="RemoveRemoteDecision_Click" />
                        <MenuFlyoutItem Text="{x:Bind SkipText}" Tag="{x:Bind Filename}" Click="SkipDecision_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="{StaticResource AppPagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="ConflictHeader" ColumnSpacing="16" RowSpacing="10" SizeChanged="ConflictHeader_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <primitives:SectionHeader Title="{Binding Title}" Subtitle="{Binding ComparisonContext}" />
            <StackPanel x:Name="ConflictBulkActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="UseLocalButton_Click" Content="{Binding UseLocalText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                <Button Click="UseRemoteButton_Click" Content="{Binding UseRemoteText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
          <StackPanel Spacing="12">
            <primitives:InfoCallout Severity="Warning" Title="{Binding WarningTitle}" Message="{Binding WarningMessage}" />
            <TextBlock Text="{Binding RiskHintMessage}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
            <Button Click="SelectRemoteRemovals_Click" Content="{Binding SelectRemoteRemovalsText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />

            <primitives:ResizableTableView
                x:Name="ConflictFilesTable"
                Height="300"
                Title="{Binding TableTitle}"
                Subtitle="{Binding TableSubtitle}"
                FooterText="{Binding TableFooterText}"
                PersistedStateKey="conflict-files-table"
                ItemsSource="{Binding ConflictFiles}" />

            <Expander Header="{Binding VersionDetailsTitle}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <primitives:PropertySheet Title="{Binding LocalTitle}">
                    <primitives:PropertySheet.PanelContent>
                        <StackPanel Spacing="12">
                            <primitives:KeyValueList ContentMaxHeight="220" ItemsSource="{Binding LocalVersion}" />
                        </StackPanel>
                    </primitives:PropertySheet.PanelContent>
                </primitives:PropertySheet>

                <primitives:PropertySheet Grid.Column="1" Title="{Binding RemoteTitle}">
                    <primitives:PropertySheet.PanelContent>
                        <StackPanel Spacing="12">
                            <primitives:KeyValueList ContentMaxHeight="220" ItemsSource="{Binding RemoteVersion}" />
                        </StackPanel>
                    </primitives:PropertySheet.PanelContent>
                </primitives:PropertySheet>
              </Grid>
            </Expander>

            <Expander Header="{Binding BaselineTitle}">
                <primitives:KeyValueList ContentMaxHeight="120" ItemsSource="{Binding SyncBaseline}" />
            </Expander>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Click="ApplyRemoteDecisionsButton_Click" Style="{StaticResource PrimaryToolbarButtonStyle}">
                <primitives:IconText Glyph="{StaticResource IconCheckCircle}" Text="{Binding BackupRestoreText}" />
            </Button>
            <Button Grid.Column="2" Click="CancelButton_Click" Style="{StaticResource SecondaryToolbarButtonStyle}">
                <primitives:IconText Glyph="{StaticResource IconClose}" Text="{Binding CancelText}" />
            </Button>
        </Grid>
    </Grid>
</Page>
