<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GSYNC.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:GSYNC.App.Primitives"
    xmlns:vm="using:GSYNC.App.ViewModels">
    <Page.Resources>
        <DataTemplate x:Key="SettingsPropertyTemplate" x:DataType="vm:UiPropertyRow">
            <Grid Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppTextDimBrush}" Text="{x:Bind Label}" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind Value}" TextWrapping="WrapWholeWords" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid x:Name="MainContentRoot" Padding="{StaticResource AppPagePadding}" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <primitives:SectionHeader Title="{Binding PageTitle}" Subtitle="{Binding PageSubtitle}" />

            <ScrollViewer x:Name="CenterScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch" Spacing="16">

                    <primitives:PropertySheet x:Name="ThemeBehaviorSheet" Title="Theme and system behavior">
                        <primitives:PropertySheet.PanelContent>
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LanguageLabel}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SupportedLanguages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ThemeModeLabel}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DensityLabel}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DensityOptions}" SelectedItem="{Binding SelectedDensityMode, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </primitives:PropertySheet.PanelContent>
                    </primitives:PropertySheet>

                    <primitives:PropertySheet x:Name="BehaviorSection" Title="{Binding BehaviorTitle}">
                        <primitives:PropertySheet.PanelContent>
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}" Text="{Binding BehaviorSubtitle}" TextWrapping="WrapWholeWords" />

                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4"><TextBlock Text="{Binding AutoPullLabel}" FontWeight="SemiBold" />
                                        <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}" Text="{Binding AutoPullDescription}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="AutoPullStatusText" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoPullEnabled, Mode=TwoWay}" OnContent="{Binding OnText}" OffContent="{Binding OffText}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AutoSnapshotLabel}" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoSnapshotEnabled, Mode=TwoWay}" OnContent="{Binding OnText}" OffContent="{Binding OffText}" />
                                </Grid>
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RefreshManifestLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch Grid.Column="1" IsOn="{Binding RefreshManifestEnabled, Mode=TwoWay}" OnContent="{Binding OnText}" OffContent="{Binding OffText}" />
                                </Grid>

                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource AppTextDimBrush}" Text="{Binding ManifestSourceUrlLabel}" />
                                    <TextBox
                                        PlaceholderText="{Binding ManifestSourceUrlPlaceholder}"
                                        Text="{Binding ManifestSourceUrlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>
                        </primitives:PropertySheet.PanelContent>
                    </primitives:PropertySheet>

                    <primitives:PropertySheet x:Name="StartupSection">
                        <primitives:PropertySheet.PanelContent>
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="StartupDescription" TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="StartupToggle" Toggled="Startup_Toggled" />
                                <TextBlock x:Name="StartupStatus" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                <Button x:Name="UpdateStartupPathButton" Click="UpdateStartupPath_Click" Visibility="Collapsed" HorizontalAlignment="Left" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                <HyperlinkButton x:Name="WindowsStartupButton" Click="WindowsStartup_Click" HorizontalAlignment="Left" Padding="0" />
                                <ToggleSwitch x:Name="CloseToTrayToggle" IsOn="{Binding CloseToTray, Mode=TwoWay}" />
                                <TextBlock x:Name="TrayDescription" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            </StackPanel>
                        </primitives:PropertySheet.PanelContent>
                    </primitives:PropertySheet>

                    <primitives:PropertySheet x:Name="UpdatesSection">
                        <primitives:PropertySheet.PanelContent>
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="VersionText" TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="AutoCheckToggle" IsOn="{Binding AutoCheckUpdates, Mode=TwoWay}" />
                                <ToggleSwitch x:Name="AutoInstallToggle" IsOn="{Binding AutoInstallUpdates, Mode=TwoWay}" IsEnabled="{Binding AutoCheckUpdates}" />
                                <TextBlock x:Name="AutoUpdateNote" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                <ScrollViewer x:Name="ReleaseNotesContainer" MaxHeight="180" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><TextBlock x:Name="ReleaseNotes" TextWrapping="Wrap" /></ScrollViewer>
                                <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                <TextBlock x:Name="DownloadStatus" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                <TextBlock x:Name="InstallStatusText" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                <TextBlock x:Name="LastUpdateResultText" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                <StackPanel Spacing="8" HorizontalAlignment="Left">
                                    <Button x:Name="CheckUpdatesButton" Click="CheckUpdates_Click" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                    <Button x:Name="ReleasesButton" Click="Releases_Click" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                    <Button x:Name="DownloadUpdateButton" Click="DownloadUpdate_Click" Visibility="Collapsed" Style="{StaticResource PrimaryToolbarButtonStyle}" />
                                    <Button x:Name="CancelUpdateButton" Click="CancelUpdate_Click" Visibility="Collapsed" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                    <Button x:Name="OpenUpdateFolderButton" Click="OpenUpdateFolder_Click" Visibility="Collapsed" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                    <Button x:Name="InstallUpdateButton" Click="InstallUpdate_Click" Visibility="Collapsed" Style="{StaticResource PrimaryToolbarButtonStyle}" />
                                    <Button x:Name="CancelInstallButton" Click="CancelInstall_Click" Visibility="Collapsed" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </primitives:PropertySheet.PanelContent>
                    </primitives:PropertySheet>

                    <primitives:PropertySheet x:Name="LoggingSection" Title="{Binding LoggingTitle}">
                        <primitives:PropertySheet.PanelContent>
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}" Text="{Binding LoggingSubtitle}" TextWrapping="WrapWholeWords" />
                                <StackPanel Spacing="6">
                                    <TextBlock Foreground="{StaticResource AppTextDimBrush}" Text="{Binding LogLevelLabel}" />
                                    <ComboBox ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}" />
                                </StackPanel>
                                <Button x:Name="OpenLogsDirButton" Click="OpenLogsDirButton_Click" Style="{StaticResource SecondaryToolbarButtonStyle}">
                                    <primitives:IconText Glyph="{StaticResource IconFolderOpen}" GlyphSize="16" Text="{Binding OpenLogsDirText}" />
                                </Button>
                            </StackPanel>
                        </primitives:PropertySheet.PanelContent>
                    </primitives:PropertySheet>

                    <primitives:PropertySheet x:Name="DiagnosticsSection" Title="{Binding DiagnosticsTitle}">
                        <primitives:PropertySheet.PanelContent>
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}" Text="{Binding DiagnosticsSubtitle}" TextWrapping="WrapWholeWords" />
                                <ItemsControl ItemTemplate="{StaticResource SettingsPropertyTemplate}" ItemsSource="{Binding Diagnostics}" />
                                <Button x:Name="OpenDataDirButton" Click="OpenDataDirButton_Click" Style="{StaticResource SecondaryToolbarButtonStyle}">
                                    <primitives:IconText Glyph="{StaticResource IconFolderOpen}" GlyphSize="16" Text="{Binding OpenDataDirText}" />
                                </Button>
                            </StackPanel>
                        </primitives:PropertySheet.PanelContent>
                    </primitives:PropertySheet>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RestoreDefaultsButton" Click="RestoreDefaultsButton_Click" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                <TextBlock x:Name="SettingsFeedback" Grid.Column="1" Margin="8,0" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Click="CancelSettingsButton_Click" Content="{Binding CancelText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                <Button x:Name="SaveSettingsButton" Grid.Column="3" Click="SaveSettingsButton_Click" Style="{StaticResource PrimaryToolbarButtonStyle}" />
            </Grid>

        </Grid>

        <Border
            x:Name="InitializationErrorPanel"
            MaxWidth="720"
            Padding="20"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{StaticResource AppSurfaceAltBrush}"
            BorderBrush="{StaticResource AppDividerBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <StackPanel Spacing="16">
                <primitives:InfoCallout
                    Title="设置页加载失败"
                    Message="无法加载设置，请重试。"
                    Severity="Error" />

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="InitializationErrorTitle"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Settings 初始化失败" />
                    <TextBlock
                        x:Name="InitializationErrorMessage"
                        Foreground="{StaticResource AppTextSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Button
                    Click="RetryInitialization_Click"
                    Style="{StaticResource PrimaryToolbarButtonStyle}">
                    <primitives:IconText Glyph="{StaticResource IconRefresh}" Text="重试加载" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
