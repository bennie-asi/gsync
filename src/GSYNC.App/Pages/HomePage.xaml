<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GSYNC.App.Pages.HomePage" x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:GSYNC.App.Primitives"
    xmlns:vm="using:GSYNC.App.ViewModels" mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="LibraryGameTemplate" x:DataType="vm:LibraryGameRow">
            <Grid Margin="0,0,0,10">
                <Border Padding="16" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Width="64" Height="86" VerticalAlignment="Top">
                            <primitives:GameArtwork FallbackText="{x:Bind Monogram}"
                                CoverUri="{x:Bind CoverUri}" LocalArtworkPath="{x:Bind LocalArtworkPath}" ProgramPath="{x:Bind ProgramPath}" />
                            <primitives:GameArtwork Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" FallbackText="{x:Bind Monogram}"
                                ProgramPath="{x:Bind ProgramPath}" Visibility="{x:Bind HasProgramPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                <primitives:Badge Grid.Column="1" Text="{x:Bind SummaryStatus}" Variant="{x:Bind SummaryStatusVariant}" />
                            </Grid>
                            <TextBlock Text="{x:Bind Metadata}" Foreground="{StaticResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind PathDescription}" Foreground="{StaticResource AppTextDimBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind PathDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Click="OpenGameDetails_Click" Content="{x:Bind OpenLabel}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                            <Button Click="CompareGame_Click" Content="{x:Bind CompareLabel}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border BorderBrush="{StaticResource AppWarningBrush}" BorderThickness="1" CornerRadius="10" IsHitTestVisible="False" Visibility="{x:Bind IsConflict, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid x:Name="MainContentRoot" Padding="{StaticResource AppPagePadding}" RowSpacing="18" SizeChanged="MainContentRoot_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="16" RowSpacing="14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                    <Button x:Name="UploadAllButton" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                    <Button x:Name="AddGameButton" Click="OpenAddGameWizard_Click" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                    <Button x:Name="SyncNowButton" Style="{StaticResource PrimaryToolbarButtonStyle}" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Padding="16,12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppWarningBrush}" BorderThickness="1" CornerRadius="10" Visibility="{Binding HasConflicts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon FontFamily="{StaticResource MaterialSymbolsFont}" Glyph="{StaticResource IconWarning}" Foreground="{StaticResource AppWarningBrush}" FontSize="22" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ConflictSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Content="{Binding ReviewConflictText}" Click="ReviewConflict_Click" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                </Grid>
            </Border>
            <Grid x:Name="FilterBar" Grid.Row="2" ColumnSpacing="8" RowSpacing="8" Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <primitives:SearchField x:Name="SearchBoxControl" PlaceholderText="Search games" Text="{Binding SearchText, Mode=TwoWay}" />
                <ComboBox x:Name="StatusFilter" Grid.Column="1" MinWidth="140" AutomationProperties.Name="{Binding StatusFilterPlaceholder}" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                <Button x:Name="SortButton" Grid.Column="2" Click="SortButton_Click" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource SecondaryToolbarButtonStyle}" />
            </Grid>
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                    <ItemsControl ItemTemplate="{StaticResource LibraryGameTemplate}" ItemsSource="{Binding Games}" />
                </ScrollViewer>
                <Border Padding="32" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="12" Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="540" Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="84" Height="84" Background="{StaticResource AppSurfaceRaisedBrush}" CornerRadius="22" HorizontalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource MaterialSymbolsFont}" Glyph="{StaticResource IconGameEsports}" Foreground="{StaticResource AppPrimaryBrush}" FontSize="42" />
                        </Border>
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource AppTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button Click="OpenAddGameWizard_Click" Content="{Binding AddGameText}" Style="{StaticResource PrimaryToolbarButtonStyle}" />
                            <Button Click="OpenTargets_Click" Content="{Binding ManageTargetsText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding EmptyTargetHint}" Foreground="{StaticResource AppTextDimBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding NoMatchesText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding ShowNoMatches, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
        <Border x:Name="InitializationErrorPanel" MaxWidth="720" Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
            <StackPanel Spacing="16">
                <primitives:InfoCallout Title="游戏库加载失败" Message="无法加载游戏库，请重试。" Severity="Error" />
                <StackPanel Spacing="6">
                    <TextBlock x:Name="InitializationErrorTitle" FontSize="20" FontWeight="SemiBold" Text="Library 初始化失败" />
                    <TextBlock x:Name="InitializationErrorMessage" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Button Click="RetryInitialization_Click" Style="{StaticResource PrimaryToolbarButtonStyle}">
                    <primitives:IconText Glyph="{StaticResource IconRefresh}" Text="重试加载" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
