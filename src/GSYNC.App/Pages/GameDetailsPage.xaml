<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GSYNC.App.Pages.GameDetailsPage" x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:GSYNC.App.Primitives"
    xmlns:vm="using:GSYNC.App.ViewModels">
    <Page.Resources>
        <DataTemplate x:Key="ContentItemTemplate" x:DataType="vm:ContentItemRow">
            <Border Margin="0,0,0,10" Padding="14" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <primitives:Badge Grid.Column="1" Text="{x:Bind Status}" Variant="{x:Bind StatusVariant}" />
                        <primitives:Badge Grid.Column="2" Text="{x:Bind EnabledText}" Variant="{x:Bind EnabledVariant}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ResolvedPath}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OpenFolderButton_Click" Content="{x:Bind OpenFolderText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                            <Button Click="TestPathButton_Click" Content="{x:Bind TestPathText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                            <Button Click="SelectItemDetails_Click" Content="{x:Bind DetailsText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                            <Button Click="EditContentPath_Click" Content="{x:Bind EditText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                            <Button Click="ToggleContentItem_Click" Content="{x:Bind ToggleText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                            <Button Click="RemoveContentItem_Click" Content="{x:Bind RemoveText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="{StaticResource AppPagePadding}" RowSpacing="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="DetailsHeader" ColumnSpacing="16" RowSpacing="12" SizeChanged="DetailsHeader_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Width="72" Height="96" VerticalAlignment="Top">
                    <primitives:GameArtwork FallbackText="{Binding GameMonogram}" CoverUri="{Binding CoverUri}"
                        LocalArtworkPath="{Binding LocalArtworkPath}" ProgramPath="{Binding ProgramPath}" />
                    <primitives:GameArtwork Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" FallbackText="{Binding GameMonogram}"
                        ProgramPath="{Binding ProgramPath}" Visibility="{Binding HasProgramPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <primitives:Badge Text="{Binding OverallStatusText}" Variant="{Binding OverallStatusVariant}" />
                        <TextBlock Text="{Binding ActiveTarget}" Foreground="{StaticResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LastPlayedText}" Foreground="{StaticResource AppTextDimBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="DetailsHeaderActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="EditGame_Click" Content="{Binding EditGameText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                    <DropDownButton Content="{Binding MoreActionsText}" MinHeight="40" CornerRadius="8"
                                    Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppDividerBrush}"
                                    BorderThickness="1" Foreground="{StaticResource AppTextSecondaryBrush}">
                        <DropDownButton.Flyout>
                            <MenuFlyout><MenuFlyoutItem x:Name="RemoveGameMenuItem" Click="RemoveGame_Click" /></MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Click="UploadButton_Click" Content="{Binding UploadText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                    <Button Click="DownloadButton_Click" Content="{Binding DownloadText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                    <Button Click="RestoreButton_Click" Content="{Binding RestoreText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                    <Button Click="OpenConflictResolution_Click" Content="{Binding CompareText}" Style="{StaticResource PrimaryToolbarButtonStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
            <StackPanel Spacing="14">
                <Border x:Name="DestinationPanel" Padding="16" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SyncDestinationTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Click="ChangeDestination_Click" Content="{Binding ChangeDestinationText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                        </Grid>
                        <Grid x:Name="DestinationOverview" ColumnSpacing="12" RowSpacing="10" SizeChanged="DestinationOverview_SizeChanged">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DestinationArrowColumn" Width="Auto" /><ColumnDefinition x:Name="DestinationTargetColumn" Width="*" /></Grid.ColumnDefinitions>
                            <Border Padding="12" Background="{StaticResource AppSurfaceAltBrush}" CornerRadius="8">
                                <StackPanel Spacing="6"><TextBlock Text="{Binding LocalDeviceLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LocalPathSummary}" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}" IsTextSelectionEnabled="True" /></StackPanel>
                            </Border>
                            <StackPanel x:Name="DestinationArrow" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="→" HorizontalAlignment="Center" FontSize="20" Foreground="{StaticResource AppPrimaryBrush}" />
                                <primitives:Badge Text="{Binding OverallStatusText}" Variant="{Binding OverallStatusVariant}" />
                            </StackPanel>
                            <Border x:Name="DestinationTargetCard" Grid.Column="2" Padding="12" Background="{StaticResource AppSurfaceAltBrush}" CornerRadius="8">
                                <StackPanel Spacing="6"><TextBlock Text="{Binding TargetLabel}" Foreground="{StaticResource AppTextDimBrush}" />
                                    <TextBlock Text="{Binding ActiveTarget}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CurrentTargetLocation}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{Binding CurrentRemoteNamespace}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="DestinationMessage" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel x:Name="DestinationEditor" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="{Binding DestinationHelp}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                            <ComboBox x:Name="DestinationTargetBox" Header="{Binding SelectTargetText}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                            <TextBox x:Name="DestinationNamespaceBox" Header="{Binding RemoteNamespaceText}" HorizontalAlignment="Stretch" />
                            <Button x:Name="LinkRemoteButton" Click="LinkRemote_Click" Content="{Binding LinkRemoteText}" Style="{StaticResource SecondaryToolbarButtonStyle}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="DestinationValidation" Foreground="{StaticResource AppWarningBrush}" TextWrapping="Wrap" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SaveDestinationButton" Click="SaveDestination_Click" Content="{Binding SaveDestinationText}" Style="{StaticResource PrimaryToolbarButtonStyle}" />
                                    <Button x:Name="CancelDestinationButton" Click="CancelDestination_Click" Content="{Binding CancelDestinationText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                    <Button x:Name="ManageDestinationButton" Click="ManageDestination_Click" Content="{Binding ManageTargetsText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Padding="16" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding AutoPullTitle}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AutoPullNote}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="AutoPullStatusText" TextWrapping="Wrap" />
                        <Button x:Name="ConfirmBaselineButton" Click="ConfirmBaseline_Click" Content="{Binding ConfirmBaselineText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                    </StackPanel>
                </Border>
                <Border x:Name="GameEditor" Padding="16" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
                    <StackPanel x:Name="GameEditorContent" Spacing="12" />
                </Border>
                <Border x:Name="ContentEditor" Padding="16" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
                    <StackPanel x:Name="ContentEditorContent" Spacing="12" />
                </Border>
                <Border Padding="16" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding TableSectionTitle}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TableSectionSubtitle}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="AddContentItem_Click" Content="{Binding AddItemText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                        </Grid>
                        <ItemsControl ItemTemplate="{StaticResource ContentItemTemplate}" ItemsSource="{Binding ContentItems}" />
                        <TextBlock Text="{Binding TableFooterText}" Foreground="{StaticResource AppTextDimBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="DetailsInspector" Padding="16" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="10" Visibility="{Binding IsInspectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3"><TextBlock Text="{Binding PropertiesTitle}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding PropertiesSubtitle}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                            <Button Grid.Column="1" Click="HideInspector_Click" Style="{StaticResource SecondaryToolbarButtonStyle}" AutomationProperties.Name="{Binding CloseDetailsText}"><FontIcon Style="{StaticResource AppIcon}" Glyph="{StaticResource IconClose}" /></Button>
                        </Grid>
                        <primitives:KeyValueList ContentMaxHeight="260" ItemsSource="{Binding SelectedItemProperties}" />
                    </StackPanel>
                </Border>
                <Grid x:Name="HistoryFeedsGrid" ColumnSpacing="14" RowSpacing="14" SizeChanged="HistoryFeedsGrid_SizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SnapshotColumn" Width="*" /></Grid.ColumnDefinitions>
                    <Border Padding="16" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel Spacing="12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding HistoryFeedTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="OpenActivityInfoButton_Click" Content="{Binding HistoryTabText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                            </Grid>
                            <primitives:ActivityFeed ContentHeight="190" ItemsSource="{Binding RecentActivityItems}" />
                            <TextBlock Text="{Binding EmptyActivityText}" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding HasRecentActivity, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="SnapshotPanel" Grid.Column="1" Padding="16" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel Spacing="12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SnapshotFeedTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                            <primitives:SnapshotFeed ContentMaxHeight="190" ItemsSource="{Binding Snapshots}" ActionText="{Binding RestoreSnapshotText}" ActionInvoked="SnapshotFeed_ActionInvoked" />
                            <TextBlock Text="{Binding EmptySnapshotsText}" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding HasSnapshots, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
