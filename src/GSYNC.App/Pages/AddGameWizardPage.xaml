<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GSYNC.App.Pages.AddGameWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:GSYNC.App.Primitives"
    xmlns:vm="using:GSYNC.App.ViewModels">
    <Page.Resources>
        <Style x:Key="WizardSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextDimBrush}" />
        </Style>
        <DataTemplate x:Key="WizardOptionTemplate" x:DataType="vm:WizardOption">
            <Button Padding="14" Margin="0,0,0,10" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{x:Bind BorderBrush}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="WizardOption_Click" AutomationProperties.Name="{x:Bind Title}" AutomationProperties.HelpText="{x:Bind Summary}" AutomationProperties.ItemStatus="{x:Bind SelectionStatus}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind Title}" />
                        <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}" Text="{x:Bind Summary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="✓" FontSize="18" Foreground="{StaticResource AppPrimaryBrush}" Visibility="{x:Bind IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="WizardSourceTemplate" x:DataType="vm:WizardOption">
            <Button Width="215" MinHeight="110" Padding="14" Margin="0,0,10,10" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{x:Bind BorderBrush}" BorderThickness="1" CornerRadius="8" HorizontalContentAlignment="Stretch" Click="WizardOption_Click" AutomationProperties.Name="{x:Bind Title}" AutomationProperties.HelpText="{x:Bind Summary}" AutomationProperties.ItemStatus="{x:Bind SelectionStatus}">
                <StackPanel Spacing="6">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind Title}" />
                    <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}" Text="{x:Bind Summary}" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource AppPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <primitives:SectionHeader Title="{Binding PageTitle}" Subtitle="{Binding PageSubtitle}" />

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Stages}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WizardStepItem">
                    <Border MinWidth="190" Padding="10" Margin="0,0,8,8" Background="{StaticResource AppSurfaceBrush}" CornerRadius="8" Opacity="{x:Bind Opacity}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Background="{StaticResource AppPrimaryBrush}" CornerRadius="14">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF0B0E17" FontWeight="SemiBold" Text="{x:Bind Indicator}" />
                            </Border>
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind Title}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding CurrentStepTitle}" />
                        <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}" Text="{Binding CurrentStepDescription}" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <primitives:DenseDataGrid Title="{Binding SourcesTitle}" Subtitle="{Binding SourcesSubtitle}" FooterText="{Binding CurrentStepFooter}" Visibility="{Binding IsStep1, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <primitives:DenseDataGrid.GridContent>
                            <StackPanel Spacing="12">
                                <ItemsControl ItemTemplate="{StaticResource WizardSourceTemplate}" ItemsSource="{Binding Sources}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <StackPanel Spacing="10" MaxWidth="680" HorizontalAlignment="Stretch" Visibility="{Binding IsManualSourceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock x:Name="ManualValidationText" Foreground="{StaticResource AppWarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                    <TextBlock Text="{Binding ManualMatchHelp}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <Button x:Name="RefreshCatalogButton" Click="RefreshCatalog_Click" Content="{Binding RefreshCatalogText}" Style="{StaticResource SecondaryToolbarButtonStyle}" HorizontalAlignment="Left" />
                                    <TextBox Header="{Binding ManualProgramLabel}" Text="{Binding ManualProgramPath}" IsReadOnly="True" />
                                    <Button Click="BrowseGameProgram_Click" Content="{Binding BrowseProgramText}" Style="{StaticResource SecondaryToolbarButtonStyle}" HorizontalAlignment="Left" />
                                    <TextBox Header="{Binding ManualNameLabel}" PlaceholderText="{Binding ManualNamePlaceholder}" Text="{Binding ManualGameName, Mode=TwoWay}" />
                                    <TextBox Header="{Binding ManualPathLabel}" PlaceholderText="C:\Users\You\Documents\My Game\Saves" Text="{Binding ManualSavePath, Mode=TwoWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="BrowseManualFolder_Click" Content="{Binding BrowseFolderText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                        <Button Click="BrowseManualFile_Click" Content="{Binding BrowseFileText}" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </primitives:DenseDataGrid.GridContent>
                    </primitives:DenseDataGrid>

                    <StackPanel Spacing="16" Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Visibility="{Binding ShowNoResultsState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Spacing="14">
                                <primitives:InfoCallout Severity="Warning" Title="{Binding NoResultsTitle}" Message="{Binding NoResultsMessage}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Click="SwitchToManualSetupButton_Click" Style="{StaticResource PrimaryToolbarButtonStyle}">
                                        <primitives:IconText Glyph="{StaticResource IconTune}" Text="{Binding NoResultsPrimaryActionText}" />
                                    </Button>
                                    <Button Grid.Column="1" Click="BackToSourceSelectionButton_Click" Style="{StaticResource SecondaryToolbarButtonStyle}">
                                        <primitives:IconText Glyph="{StaticResource IconArrowBack}" Text="{Binding NoResultsSecondaryActionText}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="16" Visibility="{Binding ShowNoResultsState, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>

                            <primitives:DenseDataGrid Title="{Binding GamesTitle}" Subtitle="{Binding GamesSubtitle}" FooterText="{Binding CurrentStepFooter}">
                                <primitives:DenseDataGrid.GridContent>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding ManualMatchMessage}" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding IsManualSourceSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ItemsControl ItemTemplate="{StaticResource WizardOptionTemplate}" ItemsSource="{Binding Games}" />
                                    </StackPanel>
                                </primitives:DenseDataGrid.GridContent>
                            </primitives:DenseDataGrid>

                            <primitives:PropertySheet Grid.Column="1" Title="{Binding Step2DetailsTitle}">
                                <primitives:PropertySheet.PanelContent>
                                    <primitives:KeyValueList ItemsSource="{Binding GameDetails}" ContentMaxHeight="220" />
                                </primitives:PropertySheet.PanelContent>
                            </primitives:PropertySheet>
                        </Grid>
                    </StackPanel>

                    <primitives:DenseDataGrid Title="{Binding ContentTitle}" Subtitle="{Binding ContentSubtitle}" FooterText="{Binding CurrentStepFooter}" Visibility="{Binding IsStep3, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <primitives:DenseDataGrid.GridContent>
                            <ItemsControl ItemTemplate="{StaticResource WizardOptionTemplate}" ItemsSource="{Binding ContentItems}" />
                        </primitives:DenseDataGrid.GridContent>
                    </primitives:DenseDataGrid>

                    <primitives:PropertySheet Title="{Binding Step4ReviewTitle}" Visibility="{Binding IsStep4, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <primitives:PropertySheet.PanelContent>
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="PathValidationText" Foreground="{StaticResource AppWarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                <ItemsControl ItemsSource="{Binding PathReview}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WizardPathReviewRow">
                                            <Border Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Result}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBox Header="{x:Bind OverrideLabel}" Text="{x:Bind OverridePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Content="{x:Bind BrowseFolderText}" Click="BrowseReviewFolder_Click" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                                        <Button Content="{x:Bind BrowseFileText}" Click="BrowseReviewFile_Click" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                                        <Button Content="{x:Bind ApplyText}" Click="RecheckPath_Click" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                                        <Button Content="{x:Bind ResetText}" Click="ResetPath_Click" Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </primitives:PropertySheet.PanelContent>
                    </primitives:PropertySheet>

                    <primitives:DenseDataGrid Title="{Binding TargetsTitle}" Subtitle="{Binding TargetsSubtitle}" FooterText="{Binding CurrentStepFooter}" Visibility="{Binding IsStep5, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <primitives:DenseDataGrid.GridContent>
                            <StackPanel Spacing="10">
                                <ItemsControl ItemTemplate="{StaticResource WizardOptionTemplate}" ItemsSource="{Binding Targets}" />
                                <Button Click="ManageTargetsButton_Click" Content="{Binding ManageTargetsText}" Style="{StaticResource SecondaryToolbarButtonStyle}" HorizontalAlignment="Left" />
                                <TextBox Header="{Binding RemoteNamespaceLabel}" Text="{Binding RemoteNamespaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding RemoteNamespaceHelp}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                <Button Click="LinkRemote_Click" Content="{Binding LinkRemoteText}" Style="{StaticResource SecondaryToolbarButtonStyle}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding LinkRemoteStatus}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </primitives:DenseDataGrid.GridContent>
                    </primitives:DenseDataGrid>

                    <primitives:PropertySheet Title="{Binding Step6ReadyTitle}" Visibility="{Binding IsStep6, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <primitives:PropertySheet.PanelContent>
                            <StackPanel Spacing="12">
                                <primitives:KeyValueList ItemsSource="{Binding FinishSummary}" />
                                <primitives:InfoCallout Title="{Binding FinishCalloutTitle}" Message="{Binding FinishCalloutMessage}" Severity="Info" />
                                <CheckBox Content="{Binding StartFirstSyncText}" IsChecked="{Binding StartFirstSync, Mode=TwoWay}" />
                            </StackPanel>
                        </primitives:PropertySheet.PanelContent>
                    </primitives:PropertySheet>
                </StackPanel>
            </ScrollViewer>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Click="CancelButton_Click" Style="{StaticResource SecondaryToolbarButtonStyle}">
                <primitives:IconText Glyph="{StaticResource IconClose}" Text="{Binding CancelText}" />
            </Button>
            <Button Grid.Column="2" Click="BackButton_Click" Style="{StaticResource SecondaryToolbarButtonStyle}" IsEnabled="{Binding CanGoBack}">
                <primitives:IconText Glyph="{StaticResource IconArrowBack}" Text="{Binding BackText}" />
            </Button>
            <Button Grid.Column="3" Click="NextButton_Click" IsEnabled="{Binding CanProceed}" Style="{StaticResource PrimaryToolbarButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Text="{Binding NextButtonText}" />
                    <FontIcon Style="{StaticResource AppIcon}" FontSize="18" Glyph="{StaticResource IconChevronRight}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
